<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!--
                TEST REBASELINE 2026-11-04 (baseline ce4f6d1):
                Files below are superseded historical specifications, not ignored defects.
                They remain in the repository for traceability and can be executed via
                phpunit.all-including-legacy.xml. Current rules are exercised under
                tests/Feature/Current/, alongside the retained passing feature tests.
                DO NOT remove these exclusions until the legacy assertions are migrated.
            -->
            <exclude>tests/Feature/ActivatedPendingIssuanceV25Test.php</exclude>
            <exclude>tests/Feature/AmsCertificateIssuanceV18Test.php</exclude>
            <exclude>tests/Feature/AmsCompletionGateV17Test.php</exclude>
            <exclude>tests/Feature/AmsDropdownDecisionV16Test.php</exclude>
            <exclude>tests/Feature/AmsIssuanceCompletionV19Test.php</exclude>
            <exclude>tests/Feature/AmsServiceCorrectionV24Test.php</exclude>
            <exclude>tests/Feature/InboxReminderWhatsAppTest.php</exclude>
            <exclude>tests/Feature/PublicRequestAndAmsVerificationTest.php</exclude>
            <exclude>tests/Feature/ReturnForCorrectionV21Test.php</exclude>
            <exclude>tests/Feature/TteManagementTest.php</exclude>
            <exclude>tests/Feature/WaTemplateManagementTest.php</exclude>
            <exclude>tests/Feature/WhatsAppWebLinkTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
