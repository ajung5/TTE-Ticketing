{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "node scripts/format-source.mjs --write",
        "format:check": "node scripts/format-source.mjs --check",
        "format:php": "node scripts/format-source.mjs --write --only php",
        "format:blade": "node scripts/format-source.mjs --write --only blade",
        "format:js": "node scripts/format-source.mjs --write --only js",
        "format:css": "node scripts/format-source.mjs --write --only css",
        "format:sql": "node scripts/format-source.mjs --write --only sql"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.25.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-blade": "^3.3.3",
        "sql-formatter": "^15.9.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
